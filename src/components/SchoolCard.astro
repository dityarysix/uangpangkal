---
import { t, paths, rupiahShort, CURRENT_YEAR, type Lang } from '../lib/i18n';
import { minEntryFee, lowestTuition, type School } from '../lib/schools';
interface Props { school: School; lang: Lang }
const { school, lang } = Astro.props;
const d = school.data;
const entry = minEntryFee(school);
const tuition = lowestTuition(school);
const years = [...new Set(d.fees.map((f) => f.academicYear))].sort().reverse();
---
<a class="card" href={paths.school(lang, school.id)}
   data-name={d.name.toLowerCase()} data-area={d.area} data-levels={d.levels.join(' ')} data-entry={entry ?? ''}>
  <div class="top">
    <h3>{d.name}</h3>
    <p class="muted loc">{d.district ? `${d.district}, ` : ''}{d.city}</p>
    <div>{d.levels.map((l) => <span class="tag">{l}</span>)}{d.religion && d.religion !== 'Umum' && <span class="tag">{d.religion}</span>}</div>
  </div>
  <dl>
    <div><dt>{t(lang, 'entryFee')}</dt><dd>{entry === 0 ? t(lang, 'free') : entry !== undefined ? rupiahShort(entry, lang) : '—'}</dd></div>
    <div><dt>{t(lang, 'tuition')}</dt><dd>{tuition ? `${rupiahShort(tuition.amount, lang)}${t(lang, `perPeriod_${tuition.period}`)}` : '—'}</dd></div>
  </dl>
  {years.length > 0 && (
    <p class="yr muted">{t(lang, 'year')} {years[0]} {years[0] === CURRENT_YEAR && <span class="badge-new">{t(lang, 'latestFees')}</span>}</p>
  )}
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 0.6rem; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; text-decoration: none; color: inherit; transition: border-color .15s, box-shadow .15s; }
  .card { border-left: 4px solid var(--teal); }
  .card:hover { border-color: var(--teal); box-shadow: 0 4px 14px rgba(30,58,95,.10); }
  h3 { margin: 0; font-size: 1.05rem; line-height: 1.3; color: var(--navy); }
  .loc { margin: 0.15rem 0 0.4rem; font-size: 0.85rem; }
  dl { display: grid; grid-template-columns: auto auto; justify-content: start; column-gap: 1.4rem; gap: 0.5rem; margin: auto 0 0; }
  dt { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }
  dd { margin: 0; font-weight: 700; font-size: 1rem; color: var(--navy); white-space: nowrap; }
  .yr { margin: 0; font-size: 0.75rem; }
</style>
