---
import { t, paths, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of the same page in the other language. */
  altPath: string;
}
const { lang, title, description, altPath } = Astro.props;
const other: Lang = lang === 'id' ? 'en' : 'id';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altPath, Astro.site);
import { ADSENSE_CLIENT, GA_MEASUREMENT_ID } from '../lib/config';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={alt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    {ADSENSE_CLIENT && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={paths.home(lang)}>uang<span>pangkal</span>.com</a>
        <nav>
          <a href={paths.correction(lang)}><span class="long">{t(lang, 'submitData')}</span><span class="short">{t(lang, 'submitDataShort')}</span></a>
          <a href={paths.about(lang)}>{t(lang, 'about')}</a>
          <a class="lang" href={altPath} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Bahasa Indonesia'}</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t(lang, 'disclaimer')}</p>
        <p>© {new Date().getFullYear()} uangpangkal.com · <a href={paths.about(lang)}>{t(lang, 'about')}</a> · <a href={paths.correction(lang)}>{t(lang, 'submitData')}</a> · <a href={paths.privacy(lang)}>{t(lang, 'privacy')}</a></p>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    /* Palette: navy = trust (nav, headings), teal = action/emphasis, cream = calm background, soft yellow = small accents. */
    --navy: #1E3A5F; --teal: #2A9D8F; --teal-text: #1F7A70; --cream: #F7F5EF; --yellow: #F2C14E;
    --ink: #1d2433; --muted: #5d6779; --line: #e4e1d8; --bg: var(--cream); --card: #fff;
    --brand: var(--teal-text); --brand-ink: var(--navy); --accent: var(--yellow); --warn-bg: #fdf3d7; --warn: #6b5000;
    --radius: 12px;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink); background: var(--bg); line-height: 1.55;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: var(--brand); }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.1rem; }
  .site-header { background: var(--navy); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { font-weight: 800; font-size: 1.2rem; text-decoration: none; color: #fff; letter-spacing: -0.02em; }
  .logo span { color: var(--yellow); }
  nav { display: flex; gap: 1.1rem; font-size: 0.95rem; white-space: nowrap; }
  nav .short { display: none; }
  @media (max-width: 560px) { nav { gap: 0.8rem; font-size: 0.9rem; } nav .long { display: none; } nav .short { display: inline; } }
  nav a { text-decoration: none; color: #d5deea; }
  nav a:hover { color: #fff; }
  main { padding: 1.5rem 1.1rem 3rem; min-height: 70vh; }
  h1, h2, h3 { color: var(--navy); }
  h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.2; letter-spacing: -0.02em; margin: 0.6rem 0; }
  h2 { font-size: 1.3rem; margin: 2rem 0 0.8rem; }
  .muted { color: var(--muted); }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; padding: 1.2rem 0; }
  .crumbs { font-size: 0.85rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .tag { display: inline-block; font-size: 0.75rem; padding: 0.1rem 0.5rem; border-radius: 99px; background: #e6f3f1; color: var(--teal-text); margin-right: 0.3rem; }
  .badge-new { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 99px; background: var(--yellow); color: var(--navy); }
  :focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; }
  .warn { background: var(--warn-bg); color: var(--warn); padding: 0.6rem 0.8rem; border-radius: 8px; font-size: 0.9rem; }
</style>
