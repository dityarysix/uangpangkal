---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { areaOfCity } from '../lib/areas';
import { t, paths, rupiah, CURRENT_YEAR, type Lang } from '../lib/i18n';
import { allSchools, latestFees, latestByLevel, compareInArea, relatedSchools, type School } from '../lib/schools';
interface Props { lang: Lang; school: School }
const { lang, school } = Astro.props;
const d = school.data;
const area = areaOfCity(d.city);
const fees = latestFees(school);
const id = lang === 'id';
const all = await allSchools();
const other: Lang = id ? 'en' : 'id';
const comparisons = [...latestByLevel(school).keys()]
  .map((level) => ({ level, ...compareInArea(all, school, level) }))
  .filter((c) => c.entry || c.tuition);
const related = relatedSchools(all, school);
const period = (p: 'month' | 'quarter' | 'semester' | 'year') => t(lang, `perPeriod_${p}`);
const prevYearStart = Number(CURRENT_YEAR.slice(0, 4)) - 1;
const isOld = (y: string) => Number(y.slice(0, 4)) < prevYearStart;
const date = (s: string) => new Date(s + 'T00:00:00').toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const title = lang === 'id'
  ? `${d.name}: Uang Pangkal, SPP & Pendaftaran ${fees[0]?.academicYear ?? ''}`.trim()
  : `${d.name}: Entry Fee, Tuition & Admissions ${fees[0]?.academicYear ?? ''}`.trim();
const desc = lang === 'id'
  ? `Rincian biaya masuk, SPP, dan prosedur pendaftaran ${d.name}, ${d.city}.`
  : `Entry fee, tuition and admission procedure for ${d.name}, ${d.city}.`;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'School', name: d.name,
  address: d.address ? { '@type': 'PostalAddress', streetAddress: d.address, addressLocality: d.city, addressCountry: 'ID' } : undefined,
  url: d.website, telephone: d.phone,
};
---
<Base lang={lang} title={title} description={desc} altPath={paths.school(lang === 'id' ? 'en' : 'id', school.id)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <p class="crumbs"><a href={paths.home(lang)}>{t(lang, 'home')}</a> › <a href={paths.area(lang, area.slug)}>{area.name[lang]}</a> › {d.name}</p>
  <h1>{d.name}</h1>
  <p class="altlang"><a href={paths.school(other, school.id)} hreflang={other} lang={other}>{id ? 'Read this page in English' : 'Baca halaman ini dalam Bahasa Indonesia'}</a></p>
  <p class="muted">{d.address ?? `${d.district ? d.district + ', ' : ''}${d.city}`}</p>
  <p>
    {d.levels.map((l) => <span class="tag">{l}</span>)}
    {d.religion && <span class="tag">{d.religion}</span>}
    {d.curriculum.map((c) => <span class="tag">{c}</span>)}
  </p>
  {(d.website || d.phone) && (
    <p class="contact">
      {d.website && <a href={d.website} rel="nofollow noopener" target="_blank">{t(lang, 'website')} ↗</a>}
      {d.phone && <span>☎ {d.phone}</span>}
    </p>
  )}

  <h2>{t(lang, 'feesTitle')}</h2>
  {fees.length === 0 && <p class="warn">{t(lang, 'noFees')}</p>}
  {fees.map((f) => (
    <article class="fee">
      <header>
        <strong>{f.level}</strong> · {t(lang, 'year')} {f.academicYear}{f.yearAssumed && <span class="muted"> ({t(lang, 'yearAssumed')})</span>} {f.academicYear === CURRENT_YEAR && <span class="badge-new">{t(lang, 'latestFees')}</span>}
      </header>
      {isOld(f.academicYear) && <p class="warn">{t(lang, 'olderData')}</p>}
      <table>
        <tbody>
          {f.registrationFee !== undefined && <tr><th>{t(lang, 'registrationFee')}</th><td>{f.registrationFee === 0 ? t(lang, 'free') : rupiah(f.registrationFee)}</td></tr>}
          {f.entryFee && <tr><th>{t(lang, 'entryFee')}</th><td>{f.entryFee.min === 0 && !f.entryFee.max ? t(lang, 'free') : rupiah(f.entryFee.min)}{f.entryFee.max && f.entryFee.max !== f.entryFee.min ? ` – ${rupiah(f.entryFee.max)}` : ''}</td></tr>}
          {f.tuition && <tr><th>{t(lang, 'tuition')}</th><td>{f.tuition.amount === 0 ? t(lang, 'free') : <>{rupiah(f.tuition.amount)}{period(f.tuition.period)}</>}</td></tr>}
          {f.otherFees.map((o) => <tr class="other"><th>{o.label[lang]}</th><td>{rupiah(o.amount)}</td></tr>)}
        </tbody>
      </table>
      {f.notes && <p class="notes">{f.notes[lang]}</p>}
      <p class="src muted">
        {t(lang, 'source')}: <a href={f.source.url} rel="nofollow noopener" target="_blank">{f.source.title}</a>{f.source.published && ` (${date(f.source.published)})`} · {t(lang, 'checked')} {date(f.checked)}
      </p>
    </article>
  ))}

  {comparisons.length > 0 && (
    <section class="compare">
      <h2>{id ? `Perbandingan dengan sekolah lain di ${area.name.id}` : `How it compares with other schools in ${area.name.en}`}</h2>
      {comparisons.map((c) => (
        <>
          <h3>{c.level}</h3>
          <ul>
            {c.entry && <li>{id
              ? `Uang pangkal ${rupiah(c.entry.mine)} (tahun ajaran ${c.entry.year}). Dari ${c.entry.n} sekolah ${c.level} di ${area.name.id} yang punya data uang pangkal, kisarannya ${rupiah(c.entry.min)} – ${rupiah(c.entry.max)}; ${c.entry.rank === 1 ? 'sekolah ini yang termurah.' : `sekolah ini urutan ke-${c.entry.rank} dari yang termurah.`}`
              : `Entry fee ${rupiah(c.entry.mine)} (academic year ${c.entry.year}). Among ${c.entry.n} ${c.level} schools in ${area.name.en} with entry-fee data, the range is ${rupiah(c.entry.min)} – ${rupiah(c.entry.max)}; ${c.entry.rank === 1 ? 'this school is the lowest.' : `this school is number ${c.entry.rank} from the lowest.`}`}</li>}
            {c.tuition && <li>{id
              ? `SPP setara ${rupiah(c.tuition.mine)} per bulan (tahun ajaran ${c.tuition.year}). Dari ${c.tuition.n} sekolah ${c.level} di ${area.name.id} yang punya data SPP, kisarannya ${rupiah(Math.round(c.tuition.min))} – ${rupiah(Math.round(c.tuition.max))} per bulan; ${c.tuition.rank === 1 ? 'sekolah ini yang termurah.' : `sekolah ini urutan ke-${c.tuition.rank} dari yang termurah.`}`
              : `Tuition equals ${rupiah(c.tuition.mine)} per month (academic year ${c.tuition.year}). Among ${c.tuition.n} ${c.level} schools in ${area.name.en} with tuition data, the range is ${rupiah(Math.round(c.tuition.min))} – ${rupiah(Math.round(c.tuition.max))} per month; ${c.tuition.rank === 1 ? 'this school is the lowest.' : `this school is number ${c.tuition.rank} from the lowest.`}`}</li>}
          </ul>
        </>
      ))}
      <p class="muted small">{id ? 'Memakai data terbaru tiap sekolah; tahun ajaran dan sumbernya dapat berbeda-beda. Ini perbandingan biaya, bukan penilaian kualitas.' : 'Uses each school’s newest data; academic years and sources may differ. This compares fees only and is not a quality rating.'}</p>
    </section>
  )}

  <AdSlot />

  <h2>{t(lang, 'admissionTitle')}</h2>
  {d.admission.length === 0 ? (
    <p class="muted">{t(lang, 'noAdmission')}</p>
  ) : (
    [...d.admission].sort((a, b) => b.academicYear.localeCompare(a.academicYear)).map((a) => (
      <article class="fee adm">
        <header>{a.level && <><strong>{a.level}</strong> · </>}{t(lang, 'year')} {a.academicYear}</header>
        {a.period && <p><strong>{t(lang, 'period')}:</strong> {a.period[lang]}</p>}
        {a.steps.length > 0 && <ol>{a.steps.map((s) => <li>{s[lang]}</li>)}</ol>}
        {a.documents.length > 0 && (<><h3>{t(lang, 'documents')}</h3><ul>{a.documents.map((s) => <li>{s[lang]}</li>)}</ul></>)}
        {a.test && <p><strong>{t(lang, 'test')}:</strong> {a.test[lang]}</p>}
        {a.notes && <p class="notes">{a.notes[lang]}</p>}
        <p class="src muted">{t(lang, 'source')}: <a href={a.source.url} rel="nofollow noopener" target="_blank">{a.source.title}</a> · {t(lang, 'checked')} {date(a.checked)}</p>
      </article>
    ))
  )}

  {related.length > 0 && (
    <section class="related">
      <h2>{id ? `Sekolah lain di ${area.name.id}` : `Other schools in ${area.name.en}`}</h2>
      <ul>
        {related.map((r) => <li><a href={paths.school(lang, r.id)}>{r.data.name}</a> <span class="muted small">{r.data.city} · {r.data.levels.join(', ')}</span></li>)}
      </ul>
      <p><a href={paths.area(lang, area.slug)}>{id ? `Lihat semua sekolah di ${area.name.id} →` : `See all schools in ${area.name.en} →`}</a></p>
    </section>
  )}

  <aside class="cta">
    <p>{t(lang, 'correctionCta')}</p>
    <a class="btn" href={paths.correction(lang, school.id)}>{t(lang, 'reportCorrection')}</a>
  </aside>

  <p class="warn disclaimer">{t(lang, 'disclaimer')}</p>
</Base>
<style>
  .contact { display: flex; gap: 1rem; }
  .altlang { font-size: 0.85rem; margin: 0 0 0.4rem; }
  .small { font-size: 0.85rem; }
  .compare ul, .related ul { padding-left: 1.2rem; }
  .compare h3 { font-size: 1rem; margin: 0.9rem 0 0.3rem; }
  .related li { margin: 0.3rem 0; }
  .fee { background: var(--card); border: 1px solid var(--line); border-top: 4px solid var(--teal); border-radius: var(--radius); padding: 1rem 1.1rem; margin-bottom: 1rem; }
  .fee header { margin-bottom: 0.6rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.45rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-weight: 500; color: var(--muted); width: 55%; }
  td { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--navy); }
  tr.other td { font-weight: 500; }
  .notes { font-size: 0.92rem; margin: 0.8rem 0 0; }
  .src { font-size: 0.8rem; margin: 0.7rem 0 0; }
  .disclaimer { margin-top: 1rem; }
  .cta { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; background: #e9f4f2; border-radius: var(--radius); padding: 1rem 1.1rem; }
  .cta p { margin: 0; color: var(--navy); }
  .btn { display: inline-block; font-weight: 700; color: #fff; background: var(--teal-text); border-radius: 8px; padding: 0.55rem 1.1rem; text-decoration: none; white-space: nowrap; }
  .btn:hover { background: var(--navy); }
  .adm h3 { font-size: 1rem; margin: 0.8rem 0 0.3rem; }
  .adm ol, .adm ul { margin: 0.3rem 0; padding-left: 1.3rem; }
</style>
